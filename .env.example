ENVIRONMENT=production
POSTGRES_PASSWORD=replace-with-a-unique-password
DATABASE_URL=postgresql+psycopg://jobagent:change-this@db:5432/jobagent
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=generate-a-long-random-secret
FILE_ENCRYPTION_KEY=generate-a-fernet-key
STORAGE_PATH=/srv/job-agent/private_uploads
STORAGE_BACKEND=local
# For S3-compatible object storage (for example Cloudflare R2), set all values below and STORAGE_BACKEND=s3.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_RESUME_BYTES=10485760
CORS_ORIGINS=http://localhost:3000
AUTO_DISCOVERY_ENABLED=false
SCHEDULER_SHARED_SECRET=generate-a-separate-long-random-secret
# Public HTTPS API hostname used by the optional Oracle VM reverse proxy.
NORTHSTAR_API_DOMAIN=
